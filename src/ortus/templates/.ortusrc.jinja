# Ortus per-project config (TOML). Overrides ~/.ortusrc.
# Generated by `ortus init` on {{ today }} using ortus {{ ortus_version }}.

prefix = "{{ prefix }}"
project_type = "{{ project_type }}"
backend = "{{ backend }}"

# CodeGraph policy: off | auto | required. `required` is the Ortus default and
# is written explicitly here so this project's policy stays legible in its own
# config and survives a change to the built-in default. `plan` and `grind`
# probe the `codegraph` CLI plus the local `.codegraph/` index before launching
# an agent; under `required` a missing prerequisite aborts the run.
codegraph = "{{ codegraph }}"

# Optional phase-specific agent profiles. Omit any field to use the selected
# provider's default. Project values override matching fields in ~/.ortusrc.
# [profiles.{{ backend }}.plan]
# model = "provider-model-name"
# reasoning_effort = "high"
#
# [profiles.{{ backend }}.implement]
# model = "provider-model-name"
# reasoning_effort = "high"
#
# [profiles.{{ backend }}.verify]
# model = "provider-model-name"
# reasoning_effort = "high"

# Push the issue branch and wait for its forge checks before fast-forwarding
# the integration branch. Off by default — a timeout is a blocker, never a pass.
# merge_gate = false
# merge_gate_timeout = 1800

{% if backend in ["local", "opencode"] -%}
# The operator-served model `ortus grind` drives through opencode, whose
# provider entry lives in opencode.json; backend = "local" is opencode's older
# name and reads this same table. `model` must be an id that
# GET {base_url}/models reports; `api_key_env` names an environment variable,
# never the key itself.
# This table stays last in the file: TOML keeps every key below a [table]
# header inside that table.
[local]
base_url = "{{ local_base_url }}"
model = "{{ local_model }}"
{% if local_api_key_env -%}
api_key_env = "{{ local_api_key_env }}"
{% endif -%}
{% else -%}
# Optional operator-served model at an OpenAI-compatible chat-completions
# server, driven by opencode (backend opencode; `local` is its older name).
# Pin it with `ortus init --backend opencode --local-model <id>`, which also
# merges the provider into opencode.json, then verify with
# `ortus check --backend opencode`. Reference serving command:
#   llama-server -hf <repo>:<quant> --alias <model> --jinja --ctx-size 32768
# [local]
# base_url = "{{ local_base_url }}"
# model = "{{ local_model or '<id as GET {base_url}/models reports it>' }}"
# api_key_env = "..."
{% endif -%}

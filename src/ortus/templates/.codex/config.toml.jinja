# Ortus project defaults for Codex. Authentication and session state remain in
# the user's normal CODEX_HOME; Ortus does not redirect CODEX_HOME into repos.
sandbox_mode = "workspace-write"
approval_policy = "never"

# These keys govern the operator's own interactive codex sessions. Ortus
# states the posture on every launch it makes instead: a worker that has to
# run its issue's checks and its own session-close commit bypasses approvals
# and the sandbox, and a verifier launches read-only.
